{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Shell",
  "version": "0.1.0",
  "identifier": "com.example.tauri-shell",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri Shell",
        "width": 1024,
        "height": 768,
        "minWidth": 740,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "acceptFirstMouse": true,
        "visible": false,
        "titleBarStyle": "Transparent",
        "theme": "Dark",
        "backgroundThrottling": "disabled",
        "windowEffects": {
          "effects": ["titlebar", "mica"]
        }
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Tauri Shell",
    "longDescription": "Tauri 2 desktop shell with open-ended connectors."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://example.com/releases/latest.json"
      ],
      "pubkey": "REPLACE_WITH_YOUR_MINISIGN_PUBKEY",
      "dialog": true
    }
  }
}
