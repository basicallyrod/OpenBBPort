{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "logs-window",
  "description": "Capability for child windows that render log streams.",
  "windows": ["jupyter-logs-*", "backend-logs-*", "process-logs-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default"
  ]
}
